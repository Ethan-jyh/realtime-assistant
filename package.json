{
  "name": "local-realtime-assistant",
  "version": "0.2.22",
  "description": "Local Realtime Assistant",
  "main": "./out/main/index.js",
  "author": "Local Realtime Assistant Team",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/build-native.cjs && electron-vite dev",
    "build": "node scripts/build-native.cjs && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:dir": "npm run build && node scripts/package-mac.cjs --dir",
    "package:mac": "npm run build && node scripts/package-mac.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
